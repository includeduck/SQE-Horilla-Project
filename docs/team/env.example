# Copy to <repo root>/.env  (PowerShell: Copy-Item docs\team\env.example .env)
# Then replace SECRET_KEY:  .\.venv\Scripts\python -c "import secrets;print(secrets.token_urlsafe(50))"
# Leave DATABASE_URL / DB_* unset: Horilla then uses <repo>/TestDB.sqlite3 (absolute path).
DJANGO_SETTINGS_MODULE=horilla.settings
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Asia/Karachi
SECURE_SSL_REDIRECT=False
